#
# Redmi AX3000 (RA81 / M81, Qualcomm IPQ5000) - OpenWrt config seed
#
# Only the essentials are listed; `make defconfig` fills in the rest.
# Wi-Fi notes:
#   * 2.4G is the IPQ5000 integrated radio (ath11k-ahb) and needs a correct
#     board_id (0x24 for M81) -> handled by our hardened hotplug script.
#   * 5G is the QCN6102 PCIe radio (ath11k-pci).
#   * calibration (caldata) is extracted from the stock ART partition at boot,
#     i.e. the vendor radio data is reused, exactly like the stock firmware.
#

CONFIG_TARGET_ipq50xx=y
CONFIG_TARGET_ipq50xx_arm=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_ipq50xx_arm_DEVICE_redmi_ax3000=y
CONFIG_TARGET_DEVICE_PACKAGES_ipq50xx_arm_DEVICE_redmi_ax3000=""

# --- Wi-Fi stack ---
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_kmod-ath11k-pci=y
CONFIG_PACKAGE_ath11k-firmware-ipq5018=y
CONFIG_PACKAGE_ath11k-firmware-qcn6122=y
CONFIG_PACKAGE_ipq-wifi-redmi_ax3000=y
CONFIG_PACKAGE_wpad-basic-wolfssl=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y

# --- LuCI (Chinese UI) ---
# In 23.05 the luci-i18n-* packages are HIDDEN with DEFAULT:=LUCI_LANG_<lang>;
# selecting them directly is a no-op (defconfig drops them). The language
# switch is what actually pulls the translations in.
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-ttyd=y

# --- useful diagnostics (small) ---
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_tcpdump-mini=y
