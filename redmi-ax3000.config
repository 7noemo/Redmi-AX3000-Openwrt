#
# Redmi AX3000 (RA81 / M81, Qualcomm IPQ5000) - OpenWrt config seed
#
# Only the essentials are listed; `make defconfig` fills in the rest.
# Wi-Fi notes:
#   * 2.4G is the IPQ5000 integrated radio (ath11k-ahb) and needs a correct
#     board_id (0x24 for M81) -> handled by our hardened hotplug script.
#   * 5G is the QCN6102 PCIe radio (ath11k-pci).
#   * calibration (caldata) is extracted from the stock ART partition at boot,
#     i.e. the vendor radio data is reused, exactly like the stock firmware.
#

CONFIG_TARGET_ipq50xx=y
CONFIG_TARGET_ipq50xx_arm=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_ipq50xx_arm_DEVICE_redmi_ax3000=y
CONFIG_TARGET_DEVICE_PACKAGES_ipq50xx_arm_DEVICE_redmi_ax3000=""

# --- Wi-Fi stack ---
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_kmod-ath11k-pci=y
CONFIG_PACKAGE_ath11k-firmware-ipq5018=y
CONFIG_PACKAGE_ath11k-firmware-qcn6122=y
CONFIG_PACKAGE_ipq-wifi-redmi_ax3000=y
CONFIG_PACKAGE_wpad-basic-wolfssl=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y

# --- LuCI (Chinese UI) ---
# In 23.05 the luci-i18n-* packages are HIDDEN with DEFAULT:=LUCI_LANG_<lang>;
# selecting them directly is a no-op (defconfig drops them). The language
# switch is what actually pulls the translations in.
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-ttyd=y

# --- useful diagnostics (small) ---
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_tcpdump-mini=y

# =====================================================================
# 常用软件
#
# 空间预算：rootfs/rootfs_1 各 36MB（0x02400000），squashfs + kernel 都要
# 塞进这 36MB，剩下才是 /overlay。所以下面每一项都是按"体积/收益"筛过的，
# 加东西前先想想 36MB 这个硬墙。
# =====================================================================

# --- 命令行工具 ---
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_mtr=y
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_ip-full=y

# --- 内核：BBR 与队列调度 ---
# 99-ra81-tuning 里设了 net.core.default_qdisc=fq + tcp_congestion_control=bbr，
# 但 fq 在 kmod-sched、bbr 在 kmod-tcp-bbr 里，模块缺失时 sysctl 会静默失败。
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-sched=y
CONFIG_PACKAGE_kmod-sched-cake=y

# --- LuCI 应用 ---
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-app-uhttpd=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-https-dns-proxy=y
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_kmod-wireguard=y

# --- 代理（PassWall 2 + Xray）---
# 只选 Xray 核心：默认在 arm 上会同时拉 sing-box + haproxy + ss-rust，
# 那套组合在 36MB 里装不下，而且 Xray 已覆盖 vless/vmess/trojan/ss。
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_Xray=y
# CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_SingBox is not set
# CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_All is not set
# firewall4 环境走 nftables 透明代理，不引入 iptables
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=y
# CONFIG_PACKAGE_luci-app-passwall2_Iptables_Transparent_Proxy is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Haproxy is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_V2ray_Plugin is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Simple_Obfs is not set
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
